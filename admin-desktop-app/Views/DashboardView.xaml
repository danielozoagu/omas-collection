<UserControl x:Class="OmasAdminApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,4,12,16">
            <!-- Metric Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Card 1: Revenue -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TOTAL REVENUE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Stats.FormattedRevenue, FallbackValue='NGN 0'}"
                                   FontSize="26" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="Gross Sales Revenue" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Orders -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TOTAL ORDERS" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Stats.TotalOrders, FallbackValue='0'}"
                                   FontSize="26" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="{Binding Stats.PendingOrders, StringFormat='{}{0} Orders Processing'}"
                                   FontSize="11" Foreground="#F59E0B" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Products -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CATALOG PRODUCTS" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Stats.TotalProducts, FallbackValue='0'}"
                                   FontSize="26" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="Active Items on Web Store" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Customers -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="REGISTERED USERS" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Stats.TotalCustomers, FallbackValue='0'}"
                                   FontSize="26" FontWeight="Bold" Foreground="#A855F7"/>
                        <TextBlock Text="Store Customer Accounts" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent Orders Section -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Recent Store Orders" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Button Content="Refresh Dashboard" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Padding="14,6"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding Stats.RecentOrders}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0F172A" BorderThickness="0"
                              RowBackground="#1E293B" AlternatingRowBackground="#162032"
                              Foreground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column"
                              MinHeight="200">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Padding"    Value="12,10"/>
                                <Setter Property="FontSize"   Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order #"  Binding="{Binding Id}"             Width="75"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Username}"       Width="160"/>
                            <DataGridTextColumn Header="Amount"   Binding="{Binding FormattedTotal}" Width="130"/>
                            <DataGridTextColumn Header="Status"   Binding="{Binding Status}"         Width="130"/>
                            <DataGridTextColumn Header="Payment"  Binding="{Binding PaymentStatus}"  Width="120"/>
                            <DataGridTextColumn Header="Date"     Binding="{Binding CreatedAt}"      Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8"
                               FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>