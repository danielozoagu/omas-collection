<UserControl x:Class="OmasAdminApp.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Orders Table Section -->
        <DockPanel Grid.Column="0" Margin="8,0,16,0">
            <!-- Filter Bar -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Status:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding StatusFilter}"
                              Width="140" Height="38" Margin="0,0,12,0"/>

                    <Button Content="Refresh Orders" Style="{StaticResource SecondaryButton}"
                            Command="{Binding LoadCommand}"/>
                </StackPanel>

                <!-- Search -->
                <TextBox Style="{StaticResource ModernTextBox}"
                         Tag="Search customer or order..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Right" Width="220" Height="38"/>
            </Grid>

            <!-- Status Indicator -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                       Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0"/>

            <!-- Orders Grid -->
            <Border Background="#0F172A" CornerRadius="10" Padding="8" BorderBrush="#1E293B" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="#1E293B" AlternatingRowBackground="#162032"
                          Foreground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #"     Binding="{Binding Id}"              Width="65"/>
                        <DataGridTextColumn Header="Customer"    Binding="{Binding Username}"        Width="120"/>
                        <DataGridTextColumn Header="Amount"      Binding="{Binding FormattedTotal}"  Width="110"/>
                        <DataGridTextColumn Header="Items"       Binding="{Binding ItemCount}"       Width="60"/>
                        <DataGridTextColumn Header="Status"      Binding="{Binding Status}"          Width="100"/>
                        <DataGridTextColumn Header="Payment"     Binding="{Binding PaymentStatus}"   Width="90"/>
                        <DataGridTextColumn Header="Date"        Binding="{Binding CreatedAt}"       Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Order Detail & Update Sidebar -->
        <Border Grid.Column="1" Background="#0F172A" CornerRadius="12" Padding="20"
                BorderBrush="#1E293B" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ORDER DETAILS" FontSize="11" FontWeight="Bold"
                               Foreground="#D97706" Margin="0,0,0,12"/>

                    <!-- Header Information -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedOrder.Id, StringFormat='Order #{0}', FallbackValue='No Order Selected'}"
                                       Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedOrder.Username, FallbackValue='Click an order in the list'}"
                                       Foreground="#94A3B8" FontSize="12" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedOrder.Email, FallbackValue=''}"
                                       Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SelectedOrder.FormattedTotal, FallbackValue='NGN 0'}"
                                       Foreground="#F59E0B" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Order Items List -->
                    <TextBlock Text="PURCHASED ITEMS" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding SelectedOrder.Items}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="6" Padding="10,8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="12" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Quantity, StringFormat='Quantity: {0}'}"
                                                       Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedSubtotal}"
                                                   Foreground="#F59E0B" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#1E293B" Margin="0,0,0,16"/>

                    <!-- Update Controls -->
                    <TextBlock Text="Fulfillment Status" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding NewStatus}"
                              Height="38" Margin="0,0,0,14"/>

                    <TextBlock Text="Payment Status" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding PaymentOptions}"
                              SelectedItem="{Binding NewPaymentStatus}"
                              Height="38" Margin="0,0,0,14"/>

                    <TextBlock Text="Courier / Tracking Number" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Tag="Courier tracking number (optional)..."
                             Text="{Binding NewTracking, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,20" Height="38"/>

                    <Button Content="Update Order Status" Style="{StaticResource PrimaryButton}"
                            Command="{Binding UpdateStatusCommand}" Height="42"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
