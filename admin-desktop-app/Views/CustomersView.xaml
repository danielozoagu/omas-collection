<UserControl x:Class="OmasAdminApp.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="8,0">
        <!-- Top Toolbar -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button Content="Refresh Directory" Style="{StaticResource SecondaryButton}"
                    Command="{Binding LoadCommand}" HorizontalAlignment="Left" Padding="14,8"/>

            <TextBox Style="{StaticResource ModernTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Right" Width="240" Height="38"/>
        </Grid>

        <!-- Status Indicator -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0"/>

        <!-- Customers Table -->
        <Border Background="#0F172A" CornerRadius="10" Padding="8" BorderBrush="#1E293B" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Customers}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="#1E293B" AlternatingRowBackground="#162032"
                      Foreground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="Padding"    Value="12,10"/>
                        <Setter Property="FontSize"   Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer ID" Binding="{Binding Id}"        Width="100"/>
                    <DataGridTextColumn Header="Full Name"   Binding="{Binding Username}"  Width="200"/>
                    <DataGridTextColumn Header="Email Address" Binding="{Binding Email}"   Width="*"/>
                    <DataGridTextColumn Header="Account Role" Binding="{Binding Role}"     Width="120"/>
                    <DataGridTextColumn Header="Member Since" Binding="{Binding CreatedAt}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>