<UserControl x:Class="OmasAdminApp.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Products List Area -->
        <DockPanel Grid.Column="0" Margin="8,0,16,0">
            <!-- Action Bar -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="+ Add New Product" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}" Margin="0,0,10,0"/>
                    <Button Content="Edit Selected" Style="{StaticResource SecondaryButton}"
                            Command="{Binding EditCommand}" Margin="0,0,10,0"/>
                    <Button Content="Delete" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}" Margin="0,0,10,0"/>
                    <Button Content="Refresh List" Style="{StaticResource SecondaryButton}"
                            Command="{Binding LoadCommand}"/>
                </StackPanel>

                <!-- Search Box -->
                <TextBox Style="{StaticResource ModernTextBox}"
                         Tag="Search products..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Right" Width="220" Height="38"/>
            </Grid>

            <!-- Status Indicator -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                       Foreground="#94A3B8" FontSize="11" Margin="0,10,0,0"/>

            <!-- Products DataGrid -->
            <Border Background="#0F172A" CornerRadius="10" Padding="8" BorderBrush="#1E293B" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="#1E293B" AlternatingRowBackground="#162032"
                          Foreground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          CanUserResizeRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"          Binding="{Binding Id}"             Width="55"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding Name}"           Width="*"/>
                        <DataGridTextColumn Header="Category"    Binding="{Binding Category}"       Width="120"/>
                        <DataGridTextColumn Header="Price"       Binding="{Binding FormattedPrice}" Width="110"/>
                        <DataGridTextColumn Header="Stock"       Binding="{Binding StockDisplay}"   Width="80"/>
                        <DataGridTextColumn Header="Created At"  Binding="{Binding CreatedAt}"      Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Product Add/Edit Form Panel -->
        <Border Grid.Column="1" Background="#0F172A" CornerRadius="12" Width="320" Padding="20"
                BorderBrush="#1E293B" BorderThickness="1"
                Visibility="{Binding ShowForm, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16"/>

                    <TextBlock Text="Product Name" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Tag="Product name..."
                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14" Height="38"/>

                    <TextBlock Text="Category" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding CategoryList}"
                              SelectedItem="{Binding FormCategory}"
                              Margin="0,0,0,14" Height="38"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Price (NGN)" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Tag="0.00"
                                     Text="{Binding FormPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stock Quantity" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Tag="0"
                                     Text="{Binding FormStock, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Tag="Product description..."
                             Text="{Binding FormDesc, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="75"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="Product Image" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Button Content="Choose File..." Style="{StaticResource SecondaryButton}"
                            Command="{Binding PickImageCommand}" Margin="0,0,0,6" Height="36"/>
                    <TextBlock Text="{Binding ImagePath, FallbackValue='No image file chosen'}"
                               Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,20"/>

                    <Button Content="Save Product" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Height="42" Margin="0,0,0,8"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}" Height="36"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
