<Window x:Class="OmasAdminApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OmasAdminApp.ViewModels"
        xmlns:views="clr-namespace:OmasAdminApp.Views"
        Title="OMAS Collection — Admin Portal"
        Width="1280" Height="820"
        MinWidth="1080" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16">
                    <TextBlock Text="OMAS" FontSize="26" FontWeight="Black"
                               Foreground="#D97706" HorizontalAlignment="Center"/>
                    <TextBlock Text="COLLECTION" FontSize="9" FontWeight="Medium"
                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <Border Height="1" Background="#334155" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Admin Profile Card -->
                <Border DockPanel.Dock="Top" Background="#1E293B" CornerRadius="10" Margin="16,0,16,20" Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="AdminNameText" Text="Admin User" FontSize="13"
                                   Foreground="#F8FAFC" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Administrator" FontSize="11" Foreground="#D97706"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Logout Button at bottom -->
                <Button DockPanel.Dock="Bottom" Content="Exit Portal (Logout)" Style="{StaticResource NavButton}"
                        Foreground="#EF4444" Margin="16,8,16,20"
                        Command="{Binding LogoutCommand}"/>

                <!-- Navigation Menu Items -->
                <StackPanel Margin="12,0">
                    <Button Content="Dashboard" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <Button Content="Products Catalog" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Products"/>
                    <Button Content="Orders Management" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Orders"/>
                    <Button Content="Customer Directory" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN VIEW AREA -->
        <Grid Grid.Column="1" Background="#0B1120">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ActiveSection}"
                               FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#10B981" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0"/>
                        <TextBlock Text="OMAS Collection Live System" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Content -->
            <ContentPresenter Grid.Row="1" Content="{Binding CurrentView}" Margin="16"/>
        </Grid>
    </Grid>
</Window>